{
  "buildCommand": "python3 build_pages.py",
  "outputDirectory": "public",
  "installCommand": "",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/products.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/d/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin.html",
      "permanent": true
    },
    {
      "source": "/admin/",
      "destination": "/admin.html",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "weiyel-uz.vercel.app"
        }
      ],
      "destination": "https://weiyel.uz/:path*",
      "permanent": true
    }
  ]
}